PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pm_system
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Used to build the link inside password-reset emails (e.g. https://your-app.onrender.com)
FRONTEND_URL=http://localhost:5173

# --- Email (task assignment notifications) ---
# Leave SMTP_HOST blank to run in dev mode, where assignment emails are
# logged to the console instead of sent (handy for local testing).
#
# Example using Gmail (requires a 16-character "App Password", not your
# normal password — generate one at https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   FROM_EMAIL=Ledgerline <youraddress@gmail.com>
#
# Or use a transactional provider (Resend, SendGrid, Mailgun, Postmark) —
# they all give you SMTP_HOST/PORT/USER/PASS values on their dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=Ledgerline <no-reply@ledgerline.app>
