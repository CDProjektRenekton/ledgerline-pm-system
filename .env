# ─────────────────────────────────────────────────────────────────────────
# Config for docker-compose.full.yml (Postgres + backend + frontend, all in
# Docker). Docker Compose reads this file automatically — you do NOT need to
# pass it in manually, and you do NOT need to fill anything in before your
# first "docker compose -f docker-compose.full.yml up -d --build".
#
# Everything below already has a working default. Edit any value and just
# re-run "docker compose -f docker-compose.full.yml up -d --build" to apply
# it — no other setup needed.
#
# This file is unrelated to backend/.env (used by the native/non-Docker
# deployment path) — the two don't interact.
# ─────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────
# Used to create the Postgres container AND to build the backend's
# connection string automatically — you don't need to write DATABASE_URL
# yourself anywhere.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pm_system

# ── Auth ────────────────────────────────────────────────────────────────
# Signs login tokens. A random value is already filled in below so you can
# start right away — but treat it like a password: rotate it if this folder
# is ever shared or committed somewhere others can see it, and definitely
# rotate it before exposing this app beyond your own machine/office network
# (e.g. before setting up a Cloudflare Tunnel or similar). Changing it logs
# everyone out (existing tokens stop validating) — that's expected.
JWT_SECRET=049793de4187e762b229c09d45a7122ab5538498bda08014d872390af573f82de47512bea70cd3b7f6eb1421c152786b
JWT_EXPIRES_IN=7d

# ── Network ─────────────────────────────────────────────────────────────
# Port on YOUR machine that maps to the app (inside Docker it always runs on
# 4000). Change the left side only, e.g. APP_PORT=8080, if 4000 is taken.
APP_PORT=4000
# Only used inside password-reset/verification email links, not for regular
# access. If you set up LAN or internet access later (see
# LOCAL_LAN_DEPLOYMENT.md / CLOUDFLARE_TUNNEL.md), update this to match.
FRONTEND_URL=http://localhost:4000
# "*" allows any origin. Fine for local/office use; tighten this to your
# exact domain (e.g. https://pms.yourdomain.com) once this is reachable from
# the wider internet.
CORS_ORIGIN=*

# ── Email (optional) ─────────────────────────────────────────────────────
# Leave all of this blank to skip real email sending — verification/reset
# emails just get logged to the container's console instead (view with
# "docker compose -f docker-compose.full.yml logs -f app"), which is fine
# for local testing. Fill in ONE of the two options below for real delivery:
#
# Option A — Google Apps Script (recommended, no SMTP setup needed):
#   see google-apps-script/README.md for the 5-minute setup, then set:
# APPS_SCRIPT_EMAIL_URL=
# APPS_SCRIPT_SECRET=
#
# Option B — traditional SMTP (Gmail App Password, SendGrid, etc.):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# APP_BRAND_NAME=MWSS RO Project Workspace
# FROM_EMAIL=
